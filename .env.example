# Biến môi trường mẫu — Sao chép thành .env và chỉnh sửa cho máy của bạn

# Đường dẫn dữ liệu
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
DATA_PREDICTIONS_DIR=data/predictions

# Random seed
SEED=42

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Streamlit settings
STREAMLIT_CLIENT_THEME=light
